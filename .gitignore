# Secrets
.env
.env.local
*.env

# Local runtime settings — contains the OpenRouter API key, real
# RIB / IBAN bank account numbers, mobile-money phone numbers used
# for the manual payment activation flow. NEVER commit, NEVER
# screen-share without redacting first.
api/data/system_settings.json

# Node
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.npm
dist/
.vite/

# Python
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
.pytest_cache/
.mypy_cache/

# Baileys auth (contains paired-account credentials — never commit)
auth_info/
auth_info_*/
api/auth_info/

