# ── Hardening for public push (github.com/medodir1000/openwacoswaz) ──────
# Every .env variant (.minimal, .generated, .local …) — but KEEP the
# .env.example templates so the required keys are still documented.
.env.*
!.env.example

# OpenWA gateway runtime: WhatsApp SESSION CREDENTIALS — browser profiles
# with web.whatsapp.com cookies/IndexedDB (= full account-hijack risk),
# the gateway sqlite DBs, and the generated env. NEVER commit any of it.
OpenWA/data/
.wwebjs_cache/
.wwebjs_auth/
**/.wwebjs_cache/
*.sqlite
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm

# Brain runtime data (manual-payment references, captured leads, local
# settings — system_settings.json already listed above).
api/data/
