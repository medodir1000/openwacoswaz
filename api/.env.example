# ─── LLM (shared across all tenant sellers) ──────────────────────────────
# Copy this value from MediaHubAccess-bot/.env — the operator pays for AI
# usage across the whole SaaS. Same key, same OpenRouter account.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini

# ─── Python brain ────────────────────────────────────────────────────────
PORT=5001
PY_WEBHOOK_URL=http://localhost:5001/webhook
SESSIONS_FILE=sessions.json

# Bridge endpoint used by brain.py for outbound messages.
BRIDGE_SEND_URL=http://localhost:3002/api/send

# ─── Supabase (new project — separate from MediaHubAccess) ───────────────
SUPABASE_URL=https://avvmyajtpnteljdttibn.supabase.co

# Anon (publishable) key — used by the admin UI only (frontend).
# Frontend RLS enforces per-seller isolation.
SUPABASE_ANON_KEY=sb_publishable_dwc94mY9KDNk8n-qfrbOMw_t4rHug1h

# Service role JWT — BACKEND ONLY. Bypasses RLS for the brain's writes
# (creating conversations, messages, orders).
# Get from: Supabase Dashboard → Project Settings → API → service_role
# DO NOT EVER expose this key in frontend code.
SUPABASE_SERVICE_KEY=

# ─── WhatsApp gateway (OpenWA — current; replaces the legacy Baileys bridge) ─
# The brain talks to the OpenWA gateway over HTTP and listens for inbound
# messages on the session below. OPENWA_API_KEY comes from OpenWA/.env; the
# session UUID comes from the dashboard's Sessions page after you pair a number.
OPENWA_API_URL=http://localhost:2785
OPENWA_API_KEY=
OPENWA_SESSION_ID=

# ─── WhatsApp bridge (Baileys — LEGACY, no longer used; kept for reference) ──
HTTP_PORT=3002
AUTH_DIR=auth_info
ADMIN_ORIGINS=http://localhost:3000,http://localhost:5181

# Human-like timing applied per-seller (read → online → typing → send)
READ_DELAY_MS=4000
READ_DELAY_JITTER_MS=4000
ONLINE_DELAY_MS=1500
ONLINE_DELAY_JITTER_MS=1500
REPLY_DELAY_MS=3000
REPLY_DELAY_JITTER_MS=3000

# Anti-ban guardrails (defaults; per-seller daily cap can override in DB)
QUIET_START_HHMM=01:00
QUIET_END_HHMM=07:00
QUIET_TIMEZONE=Africa/Casablanca
DAILY_MSG_CAP_DEFAULT=200
PER_USER_RATE_MS=8000
