{
  "name": "leadecombot-api",
  "version": "0.1.0",
  "description": "Multi-tenant WhatsApp SaaS — Baileys bridge + Flask brain supervisor",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file=.env --use-system-ca server.js",
