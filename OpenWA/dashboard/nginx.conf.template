# Closwiz dashboard — production nginx (Railway / Docker).
#
# The official nginx image runs `envsubst` on /etc/nginx/templates/*.template
# at container start, substituting the ${...} env vars below (set as Railway
# service Variables). nginx runtime vars ($host, $uri, $http_upgrade, …) are
# NOT environment variables, so envsubst leaves them untouched.
#
#   PORT         → the port Railway tells us to listen on
#   GATEWAY_URL  → OpenWA gateway base. PREFER the service's PUBLIC URL, e.g.
#                  https://skillful-creation-production-0d34.up.railway.app
#   BRAIN_URL    → Flask brain base. PREFER the PUBLIC URL, e.g.
#                  https://talented-achievement-production-e242.up.railway.app
#
# Why public URLs: Railway reassigns a service's *private* IP on every
# redeploy; a static proxy_pass to `*.railway.internal` caches the old IP and
# 502s until the dashboard is ALSO redeployed (the endless "redeploy the
# dashboard again" dance). The PUBLIC `*.up.railway.app` domain resolves to
# Railway's stable edge, so this never goes stale. We therefore do NOT force a
# Host header (nginx defaults Host to $proxy_host = the upstream's own
# hostname, which is what the Railway edge needs to route to the right
# service) and we enable SNI for the upstream TLS handshake.
server {
    listen ${PORT};
    server_name _;
    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml;

    # Brain (Flask) — tenant API consumed by the dashboard (/funnel/*).
    # NOTE: in dev this is the Vite proxy; in prod nginx must route it or the
    # whole seller dashboard (products, billing, sessions list…) breaks.
    location /funnel/ {
        proxy_pass ${BRAIN_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_connect_timeout 15s;
        proxy_read_timeout 120s;
    }

    # Gateway (OpenWA) — REST API.
    location /api/ {
        proxy_pass ${GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
        # Long read timeout: POST /api/sessions/:id/start awaits a Chromium
        # launch that can legitimately take a while on a cold container.
        proxy_connect_timeout 15s;
        proxy_send_timeout 180s;
        proxy_read_timeout 180s;
    }

    # Gateway — Socket.IO (live session status + pairing QR).
    location /socket.io/ {
        proxy_pass ${GATEWAY_URL};
        proxy_http_version 1.1;
        proxy_ssl_server_name on;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_cache_bypass $http_upgrade;
        proxy_connect_timeout 15s;
        proxy_read_timeout 180s;
    }

    # SPA routing — serve index.html for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
